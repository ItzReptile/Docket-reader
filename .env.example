# Copy this file to .env and fill it in. .env is gitignored.

# Free key from https://api.data.gov/signup/ (DEMO_KEY works for a handful of requests)
REGS_API_KEY=DEMO_KEY
# Requests per hour to stay under. api.data.gov keys allow 1,000/hour; DEMO_KEY allows 10.
REGS_REQUESTS_PER_HOUR=900

# Any Postgres 14+ works. scripts/create-db.sql creates this user and database.
DATABASE_URL=postgres://docket:docket@localhost:5432/docket

# LLM used for extraction: "ollama" (default, local) or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
OLLAMA_URL=http://127.0.0.1:11434
# Context window passed to Ollama. Bigger uses more VRAM.
OLLAMA_NUM_CTX=8192

# Only read when LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Embeddings for merging similar arguments (always via Ollama)
EMBED_MODEL=nomic-embed-text

PORT=3000
